# Preview is the safe default; no connection or customer persistence.
RF_MODE=preview
# For an approved deployment in a NEW dedicated Royal Flush Supabase project:
# RF_MODE=live
# RF_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# RF_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Set these in the build environment; .env files are not loaded automatically.

